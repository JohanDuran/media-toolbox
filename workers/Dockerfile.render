# syntax=docker/dockerfile:1.7
#
# Render worker (CPU): ffmpeg, ffprobe and the Shorts helpers, wrapped by the same small Python worker server as
# the GPU tools. HyperFrames (and its Chrome) moved to the MangoAI editor in v0.4.0.

FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1
RUN apt-get update  && apt-get install -y --no-install-recommends       ffmpeg fonts-liberation fonts-noto-core fonts-noto-color-emoji fonts-dejavu-core  && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir fastapi==0.156.4 uvicorn==0.54.0

# An unprivileged user (uid 1000, as before).
RUN useradd --uid 1000 --create-home toolbox
USER toolbox
WORKDIR /app
COPY --chown=toolbox:toolbox common/toolbox_worker.py common/shorts_spec.py render/server.py render/shorts_build.py /app/
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s   CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=4)"
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000", "--log-level", "warning"]
