# Media toolbox settings. Copy this file to .env and fill in your own paths
# (install.ps1 does this for you). Windows paths; forward or back slashes both work.
# .env is git-ignored.

# Your user folder. It is mounted into every container at /host, so any file
# under it can be passed to the toolbox as a normal Windows path.
HOST_HOME=C:/Users/you

# Port for the dashboard, REST API and MCP endpoint (bound to localhost only).
PORT=8765

# GPU tools (transcription, sound effects, text to speech) need an NVIDIA GPU.
# Leave empty on a machine without one: ffmpeg, HyperFrames renders and Shorts still work.
COMPOSE_PROFILES=gpu

# Image version pulled from ghcr.io (a release tag like v0.1.0, or latest).
TOOLBOX_VERSION=latest

# Your studio folder holds your video projects and generated content.
# Where a tool writes when you don't give it an output folder:
OUTPUTS_DIR=C:/Users/you/media-studio/_scratch

# Shared sound library (generated SFX + index.jsonl catalog), reused across videos.
SFX_LIBRARY=C:/Users/you/media-studio/sfx_library

# Where the dashboard's Shorts page looks for projects (folders with a short.json, up to 2 levels deep).
SHORTS_ROOT=C:/Users/you/media-studio

# Folders the toolbox may read but must never write into (comma separated),
# e.g. your raw recordings, from any screen recorder, camera or phone.
PROTECTED_DIRS=C:/Users/you/media-studio/recordings

# Names and terms transcription should recognize (product names, people, jargon).
# Blank = a built-in list about Claude, MCP, DaVinci Resolve and HyperFrames.
TRANSCRIBE_VOCAB=

# Windows font folder, mounted read-only into the render worker for Shorts graphics.
# Without Segoe UI there, the open Noto Sans font in the image is used.
WINDOWS_FONTS=C:/Windows/Fonts
