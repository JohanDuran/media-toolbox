# Media toolbox settings. Copy this file to .env and fill in your own paths.
# Windows paths; forward or back slashes both work. .env is git-ignored.

# Your user folder. It is mounted into every container at /host, so any file
# under it can be passed to the toolbox as a normal Windows path.
HOST_HOME=C:/Users/you

# Port for the dashboard, REST API and MCP endpoint (bound to localhost only).
PORT=8765

# Where a tool writes when you don't give it an output folder.
OUTPUTS_DIR=C:/Users/you/Documents/Projects/media-toolbox/outputs

# Shared sound library (generated SFX + index.jsonl catalog).
SFX_LIBRARY=C:/Users/you/Documents/sfx_library

# Folders the toolbox may read but must never write into (comma separated),
# e.g. your raw recordings.
PROTECTED_DIRS=C:/Users/you/Videos/OBS

# Where the dashboard's Shorts page looks for projects (folders with a short.json, up to 2 levels deep).
SHORTS_ROOT=C:/Users/you/Documents/Projects

# Windows font folder, mounted read-only into the render worker for Shorts graphics.
WINDOWS_FONTS=C:/Windows/Fonts
